rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Claims-only role checks. No get() / profile-doc lookups.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isStaff() {
      return isAdmin() || (
        signedIn() && request.auth.token.role in ['teacher', 'lecturer']
      );
    }

    // Role is NEVER client-writable. Clients create their own user doc with
    // role fixed to 'learner'; upgrades happen via custom claims / console.
    match /users/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'learner';
      allow read: if signedIn()
                    && (request.auth.uid == userId || isStaff());
      allow update: if signedIn()
                    && (request.auth.uid == userId || isAdmin())
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Registration profiles written by onboarding flows.
    match /students/{studentId} {
      allow create: if signedIn()
                    && request.auth.uid == studentId
                    && request.resource.data.role == 'learner';
      allow read: if signedIn() && (request.auth.uid == studentId || isStaff());
      allow update: if signedIn()
                    && (request.auth.uid == studentId || isStaff())
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      // Staff profiles are provisioned by an admin only after the corresponding
      // custom claim is granted. A learner must never be able to self-create a
      // teacher record (that would spoof staff UI even though rules stay safe).
      allow create: if isAdmin();
      allow read: if signedIn()
                    && (request.auth.uid == teacherId || isStaff());
      allow update: if signedIn()
                    && (request.auth.uid == teacherId || isStaff())
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Educator applications: self-created, admin-reviewed. This is NOT a staff
    // profile; the applicant becomes staff only after an admin verifies the
    // application and grants a custom claim.
    match /teacher_applications/{applicantId} {
      allow create: if signedIn()
                    && request.auth.uid == applicantId
                    && request.resource.data.role == 'teacher'
                    && request.resource.data.status == 'pending';
      allow read: if signedIn()
                    && (request.auth.uid == applicantId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Catalog: signed-in reads; staff writes; admin deletes.
    match /departments/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /courses/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /lectures/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /curriculum/{courseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /timetable/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /assignments/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Submissions: students create/read own; staff read all and grade.
    match /submissions/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.studentId;
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow update: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow delete: if isAdmin();
    }

    // Attendance: students check in as self; staff manage.
    match /attendance/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.studentId;
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow update, delete: if isStaff();
    }

    // Learner progress: students read own; staff read/write.
    match /learner_progress/{id} {
      allow create: if isStaff();
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Notifications: staff create; recipient or staff read/update.
    match /notifications/{id} {
      allow read, update: if signedIn()
                    && (request.auth.uid == resource.data.recipientId || isStaff());
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Messages: participants (sender/recipient) or staff read; sender creates.
    match /messages/{id} {
      allow read: if signedIn()
                    && (request.auth.uid == resource.data.senderId
                        || request.auth.uid == resource.data.recipientId
                        || isStaff());
      allow create: if signedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isStaff();
    }

    match /badges/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Audit trail: admins read; signed-in clients may append small entries.
    // NOTE (Phase 1): move audit writes to Cloud Functions (server timestamps,
    // IP hashing, per-IP quotas) and tighten this to functions-only.
    // NOTE (spam/rate-limit): Firestore rules cannot do time-based throttling
    // natively. Abuse control is layered: client honeypot (`companyWebsite`) +
    // 60s contact-form resubmit gate, owner-scoped creates below, and (planned)
    // App Check enforcement + Cloud Functions per-IP quotas before production.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
                    && request.resource.data.details is string
                    && request.resource.data.details.size() < 2000;
      allow update, delete: if false;
    }

    // Synced class recordings: written only by the youtubeSync Function
    // (Admin SDK bypasses rules); clients read for replay lists.
    match /recordings/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
