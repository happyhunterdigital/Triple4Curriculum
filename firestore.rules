rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn() && request.auth.token.keys().hasAny(['role', 'admin'])
        ? (request.auth.token.keys().hasAll(['role']) ? request.auth.token.role : (request.auth.token.admin == true ? 'admin' : ''))
        : '';
    }

    function isAdmin() {
      return signedIn() && (userRole() == 'admin' || request.auth.token.admin == true);
    }

    function profileRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isStaff() {
      return isAdmin() || userRole() in ['teacher', 'lecturer'] || profileRole() in ['teacher', 'admin'];
    }

    // Role is NEVER client-writable. Clients create their own user doc with
    // role fixed to 'learner'; upgrades happen via custom claims / console.
    // Signed-in directory reads support collaboration features.
    match /users/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'learner';
      allow read: if signedIn();
      allow update: if signedIn()
                    && (request.auth.uid == userId || isAdmin())
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Registration profiles written by onboarding flows.
    match /students/{studentId} {
      allow create: if signedIn()
                    && request.auth.uid == studentId
                    && request.resource.data.role == 'learner';
      allow read: if signedIn() && (request.auth.uid == studentId || isStaff());
      allow update: if signedIn()
                    && (request.auth.uid == studentId || isStaff())
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow create: if signedIn()
                    && request.auth.uid == teacherId
                    && request.resource.data.role == 'teacher';
      allow read: if signedIn();
      allow update: if signedIn()
                    && (request.auth.uid == teacherId || isStaff())
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Public catalog reads; staff writes.
    match /departments/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /courses/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /lectures/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /curriculum/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    match /timetable/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /assignments/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Submissions: students create/read own; staff read all and grade.
    match /submissions/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.studentId;
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow update: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow delete: if isAdmin();
    }

    // Attendance: students check in as self; staff manage.
    match /attendance/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.studentId;
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow update, delete: if isStaff();
    }

    // Learner progress: students read own; staff read/write.
    match /learner_progress/{id} {
      allow create: if isStaff();
      allow read: if signedIn() && (request.auth.uid == resource.data.studentId || isStaff());
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Notifications: staff create; recipients read/update own.
    match /notifications/{id} {
      allow read, update: if signedIn()
                    && (request.auth.uid == resource.data.recipientId || isStaff());
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isStaff();
    }

    match /badges/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Audit trail: staff write, admins read.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
