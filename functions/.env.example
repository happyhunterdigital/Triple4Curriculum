# Functions secrets (firebase functions:secrets:set KEY). Never commit real values.
# Used by functions/src/index.ts via process.env (declared in secrets[]).
GEMINI_API_KEY=""
RESEND_API_KEY=""
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
# Optional: "true" routes checkout + validation to PayFast sandbox. Live when unset.
PAYFAST_SANDBOX=""
APP_BASE_URL="https://triple4c.com"

# YouTube <-> Drive recording sync (functions/src/youtubeSync.ts)
# OAuth client (Web) with scopes drive.readonly + youtube.upload;
# refresh token from: node scripts/youtube-auth.mjs
YT_OAUTH_CLIENT_ID=""
YT_OAUTH_CLIENT_SECRET=""
YT_OAUTH_REFRESH_TOKEN=""
# Drive folder id where Meet auto-recordings land (from the calendar's
# "Automatically record to Drive" folder setting)
YT_DRIVE_RECORDINGS_FOLDER=""
