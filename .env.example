# FIREBASE: required. Web app config from
# Firebase Console > Project Settings > General > Your Apps (SDK setup).
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_APP_ID"

# GEMINI (optional, client-side): enables live AI quiz generation in the app.
# Without it, the tutor falls back to bundled practice questions.
# Only use a key with strict API restrictions (HTTP referrers: triple4c.com).
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SEEDING (local only, never commit): service-account JSON used by
# `bun run seed` to populate catalog collections in Firestore.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
